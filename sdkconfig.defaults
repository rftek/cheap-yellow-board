# Bluepad32 uses the BTstack host, which talks to the ESP32 Bluetooth
# controller directly. Neither Bluedroid nor NimBLE is used.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n

# Dual mode: Classic (BR/EDR) for older pads and BLE for the Xbox One S /
# Series controllers, which connect over Bluetooth Low Energy.
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n

# We supply our own Bluepad32 platform (get_xbox_platform()).
CONFIG_BLUEPAD32_PLATFORM_CUSTOM=y

# Headroom for btstack_init() + uni_init() on the main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
